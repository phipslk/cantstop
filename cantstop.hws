@APPTITLE "Can't Stop"
@APPAUTHOR "Philipp Lonke"
@APPCOPYRIGHT "(C) Copyright 2026 by Philipp Lonke"
@APPVERSION "$VER: Can't Stop 0.1 beta"
@APPDESCRIPTION "A Can't Stop clone"

@DISPLAY {Width = 810, Height = 555, Color = #BLACK, Mode = "Windowed"}

; Soundeffekte vorladen (muessen neben cantstop.hws liegen).
@IF #HW_AMIGA
	@SAMPLE 101, "dice.8svx"
	@SAMPLE 102, "bust.8svx"
	@SAMPLE 103, "win.8svx"
	@SAMPLE 104, "place.8svx"
@ELSE
	@SAMPLE 101, "dice.wav"
	@SAMPLE 102, "bust.wav"
	@SAMPLE 103, "win.wav"
	@SAMPLE 104, "place.wav"
@ENDIF
	

; ════════════════════════════════════════════════════════════════════════
; SPIELFELD-LAYOUT
; ════════════════════════════════════════════════════════════════════════

; Klassische Can't-Stop-Spaltenhoehen (2->3, 3->5, ... 7->13, ... 12->3).
columns   = {3, 5, 7, 9, 11, 13, 11, 9, 7, 5, 3}
maxHeight = 13
colWidth  = 40
; rowHeight von 40 auf 37 verkleinert, damit die jetzt 13 Felder hohe Spalte 7
; (13 * 37 = 481 px) samt Nummernbeschriftung noch ins 555 px hohe Fenster passt.
rowHeight = 37
startX    = 30
startY    = 520   ; Unterkante der laengsten Spalte; Feld sitzt oben am Fensterrand
panelX    = 510

; ── Farben laut Doku (#MAROON statt #BROWN, da #BROWN nicht existiert) ────
spielerFarben = {}
spielerFarben[1] = #MAROON
spielerFarben[2] = #BLUE
spielerFarben[3] = #GREEN
spielerFarben[4] = #FUCHSIA

; ── Globaler Spaltenbesitz ────────────────────────────────────────────────
colOwner = {}
For colInit = 2 To 12
	colOwner[colInit] = 0
Next

; ── Spielzustand ─────────────────────────────────────────────────────────
nr_player      = 2
nr_human       = 1              ; Spieler 1..nr_human = Menschen, danach Computer
isComputer     = {}
For aiInit = 1 To 4
	isComputer[aiInit] = False
Next
aiThinking     = False          ; True waehrend ein Computer spielt (menschliche Klicks ignorieren)
; Fortschritt flach ablegen: rowStore[plr*100 + spalte]. Vermeidet die
; verschachtelte Tabelle Player[plr].Row[spalte], die in Hollywood beim
; ersten Eintrag (Spieler 1) nicht zuverlaessig persistierte.
rowStore       = {}
gameReady      = False
tempMarker     = {}
prevTempMarker = {}
For markerInit = 2 To 12
	tempMarker[markerInit]     = 0
	prevTempMarker[markerInit] = 0
Next

wurf        = {}
wurfAnzahl  = 0
gewuerfelt  = False
currentPl   = 1
winner      = 0
buttonCount = 0
buttonIds   = {}   ; IDs der tatsaechlich erzeugten WÄHLEN-Buttons
selectedIdx = -1
phase       = "menu"    ; menu -> regeln -> (Abfrage) -> spielen/bust/ende

; ── Startmenue- und Regeln-Buttons ────────────────────────────────────────
menuStartId = 40
menuRulesId = 41
menuEndId   = 42
menuBackId  = 43
menuActive  = False
backActive  = False

; ── Dedizierte Buttons (feste IDs, getrennt vom WÄHLEN-Bereich 1..3) ──────
endBtnId      = 99
quitBtnId     = 98
endBtnX       = panelX
endBtnY       = 360
endBtnW       = 230
endBtnH       = 28
endTurnActive = False
quitActive    = False

; ── Spalten-Auswahl, wenn beim letzten freien Runner zwei Spalten in Frage
;    kommen (Paar mit zwei verschiedenen, neuen Summen) ────────────────────
choiceBtnId1  = 21
choiceBtnId2  = 22
choiceActive  = False
choicePending = False   ; blockiert Würfeln/Zug-Beenden bis Auswahl getroffen
choiceCol1    = 0
choiceCol2    = 0

; ── Primaerer Aktions-Button (kontextabhaengig: Start / Würfeln / Setzen
;    und weiter würfeln / Nächster Spieler) ───────────────────────────────
primaryBtnId  = 30
primaryActive = False
primaryBtnX   = panelX
primaryBtnY   = 400
primaryBtnW   = 230   ; identisch zu endBtnW ("Setzen und Zug beenden")
primaryBtnH   = 28

; ── Knopf-Farben (Basis + heller Glanzstreifen oben) ──────────────────────
btnGreenBase = $2E9E52
btnGreenLite = $47C56E
btnRedBase   = $B23A2E
btnRedLite   = $D65A4C
btnBlueBase  = $2F6BA6
btnBlueLite  = $4A8AC8

; ── Sound-IDs (vorgeladen via @SAMPLE oben) ───────────────────────────────
sndDice  = 101
sndBust  = 102
sndWin   = 103
sndPlace = 104   ; kurzer Klick beim Setzen/Vorrücken eines Runners

; ── Sprache / Uebersetzungen ──────────────────────────────────────────────
menuLangId = 44
lang    = "de"          ; "de" oder "en"
; Flache Tabelle mit zusammengesetzten Schluesseln ("de_xxx"/"en_xxx").
; Verschachtelte Zuweisung (strings.de.xxx = ...) persistiert in Hollywood
; NICHT zuverlaessig (Zwischenzugriff liefert Kopie) - daher nur eine Ebene.
strings = {}

strings["de_subtitle"]    = "Das Würfel-Wagnis-Spiel"
