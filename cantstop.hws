strings["de_rules"] = {
	"Ziel: Als Erster 3 Spalten erobern.",
	"",
	"- 3 weisse Runner pro Zug, max. 3 Spalten aktiv.",
	"- 4 Würfel zu 2 Paaren kombinieren (Summen 2-12),",
	"  eine Paarung wählen; beide Summen rücken vor",
