Function RowKey(plr, spalte)
	Return(plr * 100 + spalte)
EndFunction

Function T(key$)
	Return(strings[lang .. "_" .. key$])
EndFunction

Function ColToIdx(spalte)
	Return(spalte - 2)
EndFunction

Function ColHeight(spalte)
	Return(columns[ColToIdx(spalte)])
EndFunction

Function SortPair(valA, valB)
	If valA > valB
		Local tmpSwap = valA
		valA = valB
		valB = tmpSwap
	EndIf
	Return(valA, valB)
EndFunction

Function ColX(spalte)
	Return(startX + ColToIdx(spalte) * colWidth)
EndFunction

Function FieldTop(spalte, stepPos)
	Local centerOffset = (maxHeight - ColHeight(spalte)) / 2
	Return(startY - (centerOffset + stepPos) * rowHeight)
EndFunction

Function FieldMidX(spalte)
	Return(ColX(spalte) + colWidth / 2)
EndFunction

Function FieldMidY(spalte, stepPos)
	Return(FieldTop(spalte, stepPos) + rowHeight / 2)
EndFunction

Function ClearButtons()

	For Local btnIdx = 0 To buttonCount - 1
		DeleteButton(buttonIds[btnIdx])
	Next
	buttonIds   = {}
	buttonCount = 0
EndFunction

Function DrawButtonBg(bx, by, bw, bh, basis, glanz)
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(bx, by, bw, bh, basis)
	SetFormStyle(#BORDER, glanz, 1)
	Box(bx + 2, by + 2, bw - 4, bh / 2 - 1, glanz)
	SetFormStyle(#BORDER, #BLACK, 1)
EndFunction

Function BtnLabel(bx, bw, ty, label$)
	TextOut(bx + (bw - TextWidth(label$)) / 2, ty, label$, {Color = #WHITE})
EndFunction

Function ShowEndTurnButton()
	If endTurnActive = False
		MakeButton(endBtnId, #SIMPLEBUTTON, endBtnX, endBtnY, endBtnW, endBtnH, {OnMouseUp = OnEndTurn})
		endTurnActive = True
	EndIf
	DrawButtonBg(endBtnX, endBtnY, endBtnW, endBtnH, btnRedBase, btnRedLite)
	SetFont(#SANS, 22)
	BtnLabel(endBtnX, endBtnW, endBtnY + 7, T("bEndTurn"))
EndFunction

Function HideEndTurnButton()
	If endTurnActive
		DeleteButton(endBtnId)
		endTurnActive = False
	EndIf
EndFunction

Function ShowWinButtons()
	Local ry = endBtnY
	Local qy = primaryBtnY
	If restartActive = False
		MakeButton(restartBtnId, #SIMPLEBUTTON, endBtnX, ry, endBtnW, endBtnH, {OnMouseUp = OnRestartGame})
		restartActive = True
	EndIf
	DrawButtonBg(endBtnX, ry, endBtnW, endBtnH, btnGreenBase, btnGreenLite)
	SetFont(#SANS, 22)
	BtnLabel(endBtnX, endBtnW, ry + 7, T("bRestart"))

	If quitActive = False
		MakeButton(quitBtnId, #SIMPLEBUTTON, endBtnX, qy, endBtnW, endBtnH, {OnMouseUp = OnQuitGame})
		quitActive = True
	EndIf
	DrawButtonBg(endBtnX, qy, endBtnW, endBtnH, btnRedBase, btnRedLite)
	SetFont(#SANS, 22)
	BtnLabel(endBtnX, endBtnW, qy + 7, T("bQuitWin"))
EndFunction

Function ShowColChoice(c1, c2)
	choiceCol1 = c1
	choiceCol2 = c2

	HideEndTurnButton()
	HidePrimaryButton()
	If choiceActive = False
		MakeButton(choiceBtnId1, #SIMPLEBUTTON, panelX,       380, 100, 32, {OnMouseUp = OnColChoice})
		MakeButton(choiceBtnId2, #SIMPLEBUTTON, panelX + 120, 380, 100, 32, {OnMouseUp = OnColChoice})
		choiceActive = True
	EndIf
	choicePending = True
	SetFillStyle(#FILLCOLOR)
	Box(panelX, 338, 810 - panelX, 98, #BLACK)
	SetFont(#SANS, 22)
	TextOut(panelX, 342, T("choicePrompt"), {Color = #YELLOW})
	DrawButtonBg(panelX,       380, 100, 32, btnBlueBase, btnBlueLite)
	DrawButtonBg(panelX + 120, 380, 100, 32, btnBlueBase, btnBlueLite)
	SetFont(#SANS, 22)
	BtnLabel(panelX,       100, 386, ToString(c1))
	BtnLabel(panelX + 120, 100, 386, ToString(c2))
EndFunction

Function HideColChoice()

	If choiceActive
		DeleteButton(choiceBtnId1)
		DeleteButton(choiceBtnId2)
		choiceActive = False
		SetFillStyle(#FILLCOLOR)
		Box(panelX, 338, 810 - panelX, 98, #BLACK)
	EndIf
EndFunction

Function ShowPrimaryButton(beschriftung$)
	If primaryActive = False
		MakeButton(primaryBtnId, #SIMPLEBUTTON, primaryBtnX, primaryBtnY, primaryBtnW, primaryBtnH, {OnMouseUp = OnPrimaryAction})
		primaryActive = True
	EndIf
	DrawButtonBg(primaryBtnX, primaryBtnY, primaryBtnW, primaryBtnH, btnGreenBase, btnGreenLite)
	SetFont(#SANS, 22)
	BtnLabel(primaryBtnX, primaryBtnW, primaryBtnY + 7, beschriftung$)
EndFunction

Function HidePrimaryButton()
	If primaryActive
		DeleteButton(primaryBtnId)
		primaryActive = False
	EndIf
	SetFillStyle(#FILLCOLOR)
	Box(primaryBtnX, primaryBtnY, primaryBtnW, primaryBtnH, #BLACK)
EndFunction

Function DrawFieldCell(spalte, stepPos)
	Local fieldX = ColX(spalte)
	Local fieldY = FieldTop(spalte, stepPos)
	Local fieldColor
	Local liteColor = 0
	Local hasLite   = True
	If colOwner[spalte] > 0
		fieldColor = spielerFarben[colOwner[spalte]]
		hasLite    = False
	ElseIf stepPos = ColHeight(spalte)
		fieldColor = #YELLOW
		liteColor  = $FFF0A0
	Else
		fieldColor = #RED
		liteColor  = $E8695C
	EndIf
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(fieldX, fieldY, colWidth, rowHeight, fieldColor)
	If hasLite
		SetFormStyle(#BORDER, liteColor, 1)
		Box(fieldX + 3, fieldY + 3, colWidth - 6, 4, liteColor)
		SetFormStyle(#BORDER, #BLACK, 1)
	EndIf
EndFunction

Function HighlightField(spalte, stepPos)
	SetFillStyle(#FILLNONE)
	SetFormStyle(#BORDER, $22DDEE, 2)

	Box(ColX(spalte) + 1, FieldTop(spalte, stepPos) + 1, colWidth - 2, rowHeight - 2, $22DDEE)
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
EndFunction

Function FillColumn(spalte, farbe)
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	For Local s = 1 To ColHeight(spalte)
		Box(ColX(spalte), FieldTop(spalte, s), colWidth, rowHeight, farbe)
	Next
EndFunction

Function DrawBoard()

	ClearRunners()
	BeginRefresh()

	SetFont(#SANS, 22)

	For Local colOffset = 0 To 10
		Local spalte    = colOffset + 2
		Local spaltenHoehe = ColHeight(spalte)
		Local fieldX    = ColX(spalte)

		For Local stepPos = 1 To spaltenHoehe
			DrawFieldCell(spalte, stepPos)
		Next

		Local topFieldY = FieldTop(spalte, spaltenHoehe)
		Local numStr$   = ToString(spalte)
		TextOut(fieldX + (colWidth - TextWidth(numStr$)) / 2, topFieldY - 24, numStr$, {Color = #WHITE})
	Next

	DrawAllMarkers()
	EndRefresh()
	SyncRunners()
EndFunction

Function DrawAllMarkers()
	If gameReady = False Then Return

	Local markerSize = 16

	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #WHITE, 1)
	For Local plr = 1 To nr_player
		Local offsetX = 2
		Local offsetY = 2
		If plr = 2 Or plr = 4
			offsetX = colWidth - markerSize - 2
		EndIf
		If plr = 3 Or plr = 4
			offsetY = rowHeight - markerSize - 2
		EndIf
		For Local spalte = 2 To 12
			Local stepPos = rowStore[RowKey(plr, spalte)]
			If stepPos > 0 And colOwner[spalte] = 0
				Local markerX = ColX(spalte) + offsetX
				Local markerY = FieldTop(spalte, stepPos) + offsetY
				Box(markerX, markerY, markerSize, markerSize, spielerFarben[plr])
			EndIf
		Next
	Next

	For Local spalte = 2 To 12
		If tempMarker[spalte] > 0
			HighlightField(spalte, tempMarker[spalte])
		EndIf
	Next
	SetFormStyle(#BORDER, #BLACK, 1)
EndFunction

runnerBrushId = 1
runnerShown   = {}

Function InitRunnerSprites()
	For Local c = 2 To 12
		CreateSprite(c, #BRUSH, runnerBrushId)
		runnerShown[c] = False
	Next
EndFunction

Function ShowRunner(spalte, stepPos)
	DisplaySprite(spalte, FieldMidX(spalte) - 10, FieldMidY(spalte, stepPos) - 10)
	runnerShown[spalte] = True
EndFunction

Function SyncRunners()
	For Local c = 2 To 12
		If tempMarker[c] > 0
			ShowRunner(c, tempMarker[c])
		ElseIf runnerShown[c]
			RemoveSprite(c)
			runnerShown[c] = False
		EndIf
	Next
EndFunction

Function ClearRunners()
	For Local c = 2 To 12
		If runnerShown[c]
			RemoveSprite(c)
			runnerShown[c] = False
		EndIf
	Next
EndFunction

Function ClearPanel()
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(panelX, 0, 810 - panelX, 555, #BLACK)
EndFunction

Function ShowScore(startzeile)
	SetFont(#SANS, 22)
	TextOut(panelX, startzeile, T("columnsWon"), {Color = #GRAY})
	Local textY = startzeile + 30
	For Local plr = 1 To nr_player
		Local wonCount = 0
		For Local spalte = 2 To 12
			If colOwner[spalte] = plr Then wonCount = wonCount + 1
		Next
		Local wer$ = T("player")
		If isComputer[plr] Then wer$ = T("computer")
		TextOut(panelX, textY, wer$ .. ToString(plr) .. ":", {Color = spielerFarben[plr]})
		TextOut(panelX + 170, textY, ToString(wonCount) .. " / 3", {Color = spielerFarben[plr]})
		textY = textY + 28
	Next
EndFunction

Function ShowPlayerHeader()
	SetFont(#SANS, 22)
	Local wer$ = T("player")
	If isComputer[currentPl] Then wer$ = T("computer")
	TextOut(panelX, 10, wer$ .. ToString(currentPl), {Color = spielerFarben[currentPl]})
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #WHITE, 1)
	Box(panelX + 172, 11, 22, 22, spielerFarben[currentPl])

	SetFormStyle(#BORDER, #BLACK, 1)
EndFunction

Function ShowStatus()

	BeginRefresh()
	ClearPanel()
	ShowPlayerHeader()
	ShowScore(110)

	HideEndTurnButton()
	If isComputer[currentPl]
		HidePrimaryButton()
		SetFont(#SANS, 22)
		TextOut(panelX, 300, T("compTurn"), {Color = #GRAY})
	Else
		ShowPrimaryButton(T("bRoll"))
	EndIf
	EndRefresh()
@IF #HW_AMIGA

	If isComputer[currentPl]
		HideGameFullButton()
	Else
		ShowGameFullButton()
	EndIf
@ENDIF
EndFunction

Function AskPlayers()
	asking = True
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(0, 0, 810, 555, #BLACK)
	SetFont(#SANS, 30)
	TextOut(#CENTER, 90, T("newGame"), {Align = #CENTER, Color = #YELLOW})

	SetFont(#SANS, 22)
	TextOut(#CENTER, 152, T("maxInfo"), {Align = #CENTER, Color = #GRAY})

	TextOut(#CENTER, 215, T("qHumans"), {Align = #CENTER, Color = #WHITE})
	Locate(398, 253)
	Local nh = ToNumber(InKeyStr(#NUMERICAL, 1, False, True))
	If nh < 1 Then nh = 1
	If nh > 4 Then nh = 4

	Box(340, 249, 130, 32, #BLACK)
	TextOut(#CENTER, 253, ToString(nh), {Align = #CENTER, Color = #YELLOW})

	Local maxC = 4 - nh
	TextOut(#CENTER, 325, T("qComputers") .. ToString(maxC) .. ")?", {Align = #CENTER, Color = #WHITE})
	Locate(398, 363)
	Local nc = ToNumber(InKeyStr(#NUMERICAL, 1, False, True))
	If nc < 0 Then nc = 0
	If nc > maxC Then nc = maxC
	Box(340, 359, 130, 32, #BLACK)
	TextOut(#CENTER, 363, ToString(nc), {Align = #CENTER, Color = #YELLOW})
	Wait(20)

	nr_human  = nh
	nr_player = nh + nc
	For Local plr = 1 To nr_player
		isComputer[plr] = (plr > nr_human)
	Next
	asking = False
EndFunction

Function HideMenuButtons()
	If menuActive
		DeleteButton(menuStartId)
		DeleteButton(menuRulesId)
		DeleteButton(menuEndId)
		DeleteButton(menuLangId)
@IF #HW_AMIGA
		DeleteButton(menuFullId)
@ENDIF
		menuActive = False
	EndIf
EndFunction

Function HideBackButton()
	If backActive
		DeleteButton(menuBackId)
		backActive = False
	EndIf
EndFunction

Function DrawMenuButton(bx, by, bw, bh, label$, basis, glanz)
	DrawButtonBg(bx, by, bw, bh, basis, glanz)
	SetFont(#SANS, 22)

	TextOut(#CENTER, by + 10, label$, {Align = #CENTER, Color = #WHITE})
EndFunction

Function ShowMenu()
	phase = "menu"
	ClearRunners()
	HideBackButton()

	DisplayBrush(2, 0, 0)
	SetFont(#SANS, 22)
	TextOut(#CENTER, 266, "by Philipp Lonke", {Align = #CENTER, Color = $E8CC78})

	Local bx = 295
	Local bw = 220
	Local bh = 42
	MakeButton(menuStartId, #SIMPLEBUTTON, bx, 312, bw, bh, {OnMouseUp = OnMenuStart})
	DrawMenuButton(bx, 312, bw, bh, T("bStart"), btnGreenBase, btnGreenLite)
	MakeButton(menuRulesId, #SIMPLEBUTTON, bx, 362, bw, bh, {OnMouseUp = OnMenuRules})
	DrawMenuButton(bx, 362, bw, bh, T("bRules"), btnBlueBase, btnBlueLite)
	MakeButton(menuEndId, #SIMPLEBUTTON, bx, 412, bw, bh, {OnMouseUp = OnMenuEnd})
	DrawMenuButton(bx, 412, bw, bh, T("bQuit"), btnRedBase, btnRedLite)

	Local otherLng$ = "en"
	If lang = "en" Then otherLng$ = "de"
	MakeButton(menuLangId, #SIMPLEBUTTON, bx, 468, bw, bh, {OnMouseUp = OnLangToggle})
	DrawMenuButton(bx, 468, bw, bh, strings[otherLng$ .. "_langLabel"] .. ": " .. strings[otherLng$ .. "_langName"], btnBlueBase, btnBlueLite)
@IF #HW_AMIGA

	DrawMenuFullButton()
	MakeButton(menuFullId, #SIMPLEBUTTON, menuFullX, menuFullY, menuFullW, menuFullH, {OnMouseUp = OnFullToggle})
@ENDIF
	menuActive = True
EndFunction

Function ShowRules()
	phase = "regeln"
	ClearRunners()
	HideMenuButtons()
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(0, 0, 810, 555, #BLACK)
	SetFont(#SANS, 30)
	TextOut(#CENTER, 25, T("rulesTitle"), {Align = #CENTER, Color = #YELLOW})

	SetFont(#SANS, 22)
	Local rules = strings[lang .. "_rules"]
	Local y = 66
	Local gruen = True
	For Local i = 0 To TableItems(rules) - 1
		If rules[i] <> ""

			Local ersterCode = Asc(rules[i])
			If ersterCode = 45 Or (ersterCode >= 65 And ersterCode <= 90)
				gruen = (gruen = False)
			EndIf
			Local zeilenFarbe = #WHITE
			If gruen Then zeilenFarbe = #GREEN
			TextOut(#CENTER, y, rules[i], {Align = #CENTER, Color = zeilenFarbe})
		EndIf
		y = y + 28
	Next

	MakeButton(menuBackId, #SIMPLEBUTTON, 305, 495, 200, 40, {OnMouseUp = OnRulesBack})
	DrawMenuButton(305, 495, 200, 40, T("bBack"), btnBlueBase, btnBlueLite)
	backActive = True
EndFunction

Function OnMenuStart(msg)
	HideMenuButtons()
	AskPlayers()
	StartGame()
EndFunction

Function OnMenuRules(msg)
	ShowRules()
EndFunction

Function OnMenuEnd(msg)
	End()
EndFunction

Function OnLangToggle(msg)
	If lang = "de" Then lang = "en" Else lang = "de"
	ShowMenu()
EndFunction

Function OnRulesBack(msg)
	ShowMenu()
EndFunction

@IF #HW_AMIGA

Function FullLabel()
	If fullscreenOn Then Return(T("bWindow"))
	Return(T("bFull"))
EndFunction

Function DrawMenuFullButton()
	SetFont(#SANS, 22)
	Local label$ = FullLabel()
	menuFullH = TextHeight(label$) + 4
	DrawButtonBg(menuFullX, menuFullY, menuFullW, menuFullH, btnBlueBase, btnBlueLite)
	TextOut(#CENTER, menuFullY + 2, label$, {Align = #CENTER, Color = #WHITE})
EndFunction

Function DrawGameFullButton()
	SetFont(#SANS, 20)
	Local label$ = FullLabel()
	Local w = TextWidth(label$) + 16

	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(gameFullX, gameFullY, gameFullClearW, gameFullH, #BLACK)
	If gameFullActive Then DeleteButton(gameFullId)
	MakeButton(gameFullId, #SIMPLEBUTTON, gameFullX, gameFullY, w, gameFullH, {OnMouseUp = OnFullToggle})
	gameFullActive = True
	DrawButtonBg(gameFullX, gameFullY, w, gameFullH, btnBlueBase, btnBlueLite)
	BtnLabel(gameFullX, w, gameFullY + 3, label$)
EndFunction

Function ShowGameFullButton()
	DrawGameFullButton()
EndFunction

Function HideGameFullButton()
	If gameFullActive
		DeleteButton(gameFullId)
		gameFullActive = False

		SetFillStyle(#FILLCOLOR)
		SetFormStyle(#BORDER, #BLACK, 1)
		Box(gameFullX, gameFullY, gameFullClearW, gameFullH, #BLACK)
	EndIf
EndFunction

Function ToggleFullscreen()
	fullscreenOn = (fullscreenOn = False)
	If fullscreenOn
		ChangeDisplayMode(#DISPMODE_FULLSCREENSCALE, {KeepProportions = True})
	Else
		ChangeDisplayMode(#DISPMODE_WINDOWED)
	EndIf
	If phase = "menu"
		DrawMenuFullButton()
	ElseIf gameFullActive
		DrawGameFullButton()
	EndIf
EndFunction

Function OnFullToggle(msg)
	ToggleFullscreen()
EndFunction
@ENDIF

Function InitPlayers()
	rowStore = {}
	For Local plr = 1 To nr_player
		For Local spalte = 2 To 12
			rowStore[RowKey(plr, spalte)] = 0
		Next
	Next
	For Local spalte = 2 To 12
		tempMarker[spalte]     = 0
		prevTempMarker[spalte] = 0
		colOwner[spalte]       = 0
	Next
	gameReady = True
EndFunction

Function ResetTempMarker()
	For Local spalte = 2 To 12
		tempMarker[spalte]     = 0
		prevTempMarker[spalte] = 0
	Next
EndFunction

Function SaveTempMarker()
	For Local spalte = 2 To 12
		prevTempMarker[spalte] = tempMarker[spalte]
	Next
EndFunction

Function RestoreTempMarker()
	For Local spalte = 2 To 12
		tempMarker[spalte] = prevTempMarker[spalte]
	Next
EndFunction

Function CountTempCols()
	Local anzahlAktiv = 0
	For Local spalte = 2 To 12
		If tempMarker[spalte] > 0 Then anzahlAktiv = anzahlAktiv + 1
	Next
	Return(anzahlAktiv)
EndFunction

Function ColPlayable(spalte)
	If colOwner[spalte] > 0 Then Return(False)
	If tempMarker[spalte] >= ColHeight(spalte) Then Return(False)
	If tempMarker[spalte] > 0 Then Return(True)
	If CountTempCols() < 3 Then Return(True)
	Return(False)
EndFunction

Function PairPlayable(summe1, summe2)
	If summe1 = summe2 Then Return(ColPlayable(summe1))
	Return(ColPlayable(summe1) Or ColPlayable(summe2))
EndFunction

Function PairNeedsChoice(summe1, summe2)
	If summe1 = summe2            Then Return(False)
	If ColPlayable(summe1) = False Then Return(False)
	If ColPlayable(summe2) = False Then Return(False)
	If tempMarker[summe1] > 0     Then Return(False)
	If tempMarker[summe2] > 0     Then Return(False)
	If (3 - CountTempCols()) >= 2 Then Return(False)
	Return(True)
EndFunction

Function MoveCol(spalte)
	If colOwner[spalte] > 0 Then Return
	If tempMarker[spalte] = 0
		tempMarker[spalte] = rowStore[RowKey(currentPl, spalte)] + 1
	Else
		tempMarker[spalte] = tempMarker[spalte] + 1
	EndIf
	If tempMarker[spalte] > ColHeight(spalte)
		tempMarker[spalte] = ColHeight(spalte)
	EndIf
EndFunction

Function CommitTempMarker()
	For Local spalte = 2 To 12
		If tempMarker[spalte] > 0
			rowStore[RowKey(currentPl, spalte)] = tempMarker[spalte]
			If tempMarker[spalte] >= ColHeight(spalte)
				colOwner[spalte] = currentPl
			EndIf
		EndIf
	Next
	ResetTempMarker()
	Local wonCount = 0
	For Local spalte = 2 To 12
		If colOwner[spalte] = currentPl Then wonCount = wonCount + 1
	Next
	If wonCount >= 3 Then winner = currentPl
EndFunction

Function AnimatedMove(spalte)
	If colOwner[spalte] > 0 Then Return
	Local fromStep = tempMarker[spalte]
	Local base = fromStep
	If fromStep = 0 Then base = rowStore[RowKey(currentPl, spalte)]
	Local toStep = base + 1
	If toStep > ColHeight(spalte) Then toStep = ColHeight(spalte)

	Local cx   = FieldMidX(spalte)
	Local yTo  = FieldMidY(spalte, toStep)
	Local yFrom
	If base >= 1
		yFrom = FieldMidY(spalte, base)
	Else

		yFrom = FieldMidY(spalte, toStep) + 9
	EndIf

	Local xSprite = FieldMidX(spalte) - 10
	DisplaySprite(spalte, xSprite, yFrom - 10)
	runnerShown[spalte] = True
	MoveSprite(spalte, xSprite, yFrom - 10, xSprite, yTo - 10, {Speed = 4})

	tempMarker[spalte] = toStep
	PlaySample(sndPlace)
EndFunction

Function AnimatedApplyPair(s1, s2)
	If ColPlayable(s1) Then AnimatedMove(s1)
	If ColPlayable(s2) Then AnimatedMove(s2)
EndFunction

comboA = {}
comboB = {}
comboC = {}
comboD = {}
comboN = {}
comboCount = 0
For cD1 = 1 To 6
	For cD2 = cD1 To 6
		For cD3 = cD2 To 6
			For cD4 = cD3 To 6

				cAnz = {0, 0, 0, 0, 0, 0, 0}
				cAnz[cD1] = cAnz[cD1] + 1
				cAnz[cD2] = cAnz[cD2] + 1
				cAnz[cD3] = cAnz[cD3] + 1
				cAnz[cD4] = cAnz[cD4] + 1
				cGewicht = 24
				For cF = 1 To 6
					If cAnz[cF] = 2 Then cGewicht = cGewicht / 2
					If cAnz[cF] = 3 Then cGewicht = cGewicht / 6
					If cAnz[cF] = 4 Then cGewicht = cGewicht / 24
				Next
				comboA[comboCount] = cD1
				comboB[comboCount] = cD2
				comboC[comboCount] = cD3
				comboD[comboCount] = cD4
				comboN[comboCount] = cGewicht
				comboCount = comboCount + 1
			Next
		Next
	Next
Next

Function BustPercent()
	Local play = {}
	For Local c = 2 To 12
		play[c] = ColPlayable(c)
	Next
	Local bust = 0
	For Local i = 0 To comboCount - 1
		Local da = comboA[i]
		Local db = comboB[i]
		Local dc = comboC[i]
		Local dd = comboD[i]

		If Not (play[da + db] Or play[dc + dd] Or play[da + dc] Or play[db + dd] Or play[da + dd] Or play[db + dc])
			bust = bust + comboN[i]
		EndIf
	Next
	Return(Int(bust * 100 / 1296 + 0.5))
EndFunction

Function ShowBustRisk()
	Local pct = BustPercent()

	Local col = #GREEN
	If pct >= 25 Then col = $FF8C00
	If pct >= 50 Then col = $FF2E9E
	Local bx = panelX + 184
	Local by = 42
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, col, 2)
	Box(bx, by, 92, 46, #BLACK)
	SetFormStyle(#BORDER, #BLACK, 1)

	SetFont(#SANS, 12)
	TextOut(bx + 6, by + 4, T("bustRisk"), {Color = #GRAY})
	SetFont(#SANS, 24)
	TextOut(bx + 6, by + 17, ToString(pct) .. "%", {Color = col})
EndFunction

Function BlinkWinnerColumns()
	Local cols = {}
	Local n = 0
	For Local c = 2 To 12
		If colOwner[c] = winner
			cols[n] = c
			n = n + 1
		EndIf
	Next
	For Local blink = 1 To 4
		For Local i = 0 To n - 1
			FillColumn(cols[i], #WHITE)
		Next
		Wait(7)
		For Local i = 0 To n - 1
			FillColumn(cols[i], spielerFarben[winner])
		Next
		Wait(7)
	Next
EndFunction

Function DrawPip(dx, dy, s, col, row)
	Local ps = s / 6
	Local px = dx + s * (col + 1) / 4 - ps / 2
	Local py = dy + s * (row + 1) / 4 - ps / 2
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(px, py, ps, ps, #BLACK)
EndFunction

Function DrawDie(dx, dy, s, Val)
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 2)
	Box(dx, dy, s, s, #WHITE)
	SetFormStyle(#BORDER, #BLACK, 1)
	If Val = 1 Or Val = 3 Or Val = 5 Then DrawPip(dx, dy, s, 1, 1)
	If Val >= 2
		DrawPip(dx, dy, s, 0, 0)
		DrawPip(dx, dy, s, 2, 2)
	EndIf
	If Val >= 4
		DrawPip(dx, dy, s, 2, 0)
		DrawPip(dx, dy, s, 0, 2)
	EndIf
	If Val = 6
		DrawPip(dx, dy, s, 0, 1)
		DrawPip(dx, dy, s, 2, 1)
	EndIf
EndFunction

Function DrawFourDice(w1, w2, w3, w4)
	Local s   = 40
	Local dy  = 42
	Local gap = 46
	DrawDie(panelX,           dy, s, w1)
	DrawDie(panelX + gap,     dy, s, w2)
	DrawDie(panelX + gap * 2, dy, s, w3)
	DrawDie(panelX + gap * 3, dy, s, w4)
EndFunction

Function RollDiceAnimation(w1, w2, w3, w4)
	PlaySample(sndDice, {Times = 0})

	For Local frame = 1 To 15
		DrawFourDice(Rnd(6) + 1, Rnd(6) + 1, Rnd(6) + 1, Rnd(6) + 1)
		Wait(2 + frame / 2)
	Next
	DrawFourDice(w1, w2, w3, w4)
	StopSample(sndDice)
EndFunction

Function DoThrowDice()
	ClearButtons()
	HideColChoice()
	choicePending = False
	wurf        = {}
	wurfAnzahl  = 0
	selectedIdx = -1

	Local wuerfel1 = Rnd(6) + 1
	Local wuerfel2 = Rnd(6) + 1
	Local wuerfel3 = Rnd(6) + 1
	Local wuerfel4 = Rnd(6) + 1

	Local summeA, summeB, summeC, summeD, summeE, summeF
	summeA, summeB = SortPair(wuerfel1 + wuerfel2, wuerfel3 + wuerfel4)
	summeC, summeD = SortPair(wuerfel1 + wuerfel3, wuerfel2 + wuerfel4)
	summeE, summeF = SortPair(wuerfel1 + wuerfel4, wuerfel2 + wuerfel3)

	wurf[0]    = {sum1 = summeA, sum2 = summeB}
	wurfAnzahl = 1
	If summeA <> summeC Or summeB <> summeD
		wurf[1]    = {sum1 = summeC, sum2 = summeD}
		wurfAnzahl = 2
	EndIf
	If (summeC <> summeE Or summeD <> summeF) And (summeA <> summeE Or summeB <> summeF)
		wurf[wurfAnzahl] = {sum1 = summeE, sum2 = summeF}
		wurfAnzahl       = wurfAnzahl + 1
	EndIf

	gewuerfelt = True

	Local anyPlayable = False
	For Local pairIdx = 0 To wurfAnzahl - 1
		If PairPlayable(wurf[pairIdx].sum1, wurf[pairIdx].sum2) Then anyPlayable = True
	Next

	BeginRefresh()
	ClearPanel()
	ShowPlayerHeader()
	HidePrimaryButton()
	HideEndTurnButton()
	EndRefresh()
	RollDiceAnimation(wuerfel1, wuerfel2, wuerfel3, wuerfel4)

	If anyPlayable = False
		PlaySample(sndBust)
		SetFont(#SANS, 22)

		TextOut(panelX, 105, "BUST!", {Color = spielerFarben[currentPl]})
		SetFont(#SANS, 22)
		TextOut(panelX, 134, T("bustNoMove"), {Color = #WHITE})
		TextOut(panelX, 162, T("bustLost"), {Color = #GRAY})
		ResetTempMarker()
		HideEndTurnButton()
		DrawBoard()
		gewuerfelt = False
		phase = "bust"

		If aiThinking = False Then ShowPrimaryButton(T("bNext"))
		Return
	EndIf

	BeginRefresh()
	Local textY = pairListY
	buttonCount = 0
	For Local pairIdx = 0 To wurfAnzahl - 1
		Local choosable = PairPlayable(wurf[pairIdx].sum1, wurf[pairIdx].sum2)
		Local textColor = #WHITE
		If choosable = False Then textColor = #GRAY
		SetFont(#SANS, 22)
		TextOut(panelX, textY, T("pair") .. wurf[pairIdx].sum1 .. " + " .. wurf[pairIdx].sum2, {Color = textColor})

		If choosable And aiThinking = False

			Local btnId = pairIdx + 1
			DrawButtonBg(panelX + 160, textY, 104, pairLineH, btnBlueBase, btnBlueLite)
			SetFont(#SANS, 22)
			TextOut(panelX + 170, textY + 4, T("select"), {Color = #WHITE})
			MakeButton(btnId, #SIMPLEBUTTON, panelX + 160, textY, 104, pairLineH, {OnMouseUp = OnPairSelect})
			buttonIds[buttonCount] = btnId
			buttonCount = buttonCount + 1
		EndIf
		textY = textY + pairListStep
	Next

	SetFont(#SANS, 22)

	If aiThinking = False
		TextOut(panelX, textY + 16, T("hint1"), {Color = #GRAY})
		TextOut(panelX, textY + 44, T("hint2"), {Color = #GRAY})
	EndIf
	ShowScore(textY + 78)

	HidePrimaryButton()
	HideEndTurnButton()
	EndRefresh()
EndFunction

Function NextPlayer()
	currentPl = currentPl + 1
	If currentPl > nr_player Then currentPl = 1
	ResetTempMarker()
	gewuerfelt  = False
	selectedIdx = -1
	phase       = "spielen"
	ClearButtons()
	HideColChoice()
	choicePending = False
	DrawBoard()
	ShowStatus()
	If isComputer[currentPl] Then PlayComputerTurn()
EndFunction

Function OnPairSelect(msg)
	If aiThinking Then Return
	If phase <> "spielen" Then Return
	Local pairIdx = msg.id - 1
	If pairIdx < 0 Or pairIdx >= wurfAnzahl Then Return

	HideColChoice()
	choicePending = False

	RestoreTempMarker()
	selectedIdx = pairIdx
	Local s1 = wurf[pairIdx].sum1
	Local s2 = wurf[pairIdx].sum2

	If PairNeedsChoice(s1, s2)
		DrawBoard()
		SetFillStyle(#FILLCOLOR)
		Box(panelX, 84, 810 - panelX, 30, #BLACK)
		SetFont(#SANS, 22)
		TextOut(panelX, 87, T("choicePair1") .. s1 .. " + " .. s2 .. T("choicePair2"), {Color = #GREEN})
		ShowColChoice(s1, s2)
		Return
	EndIf

	DrawBoard()
	AnimatedApplyPair(s1, s2)
	DrawBoard()

	SetFillStyle(#FILLCOLOR)
	Box(panelX, 84, 810 - panelX, 30, #BLACK)
	SetFont(#SANS, 22)
	TextOut(panelX, 87, T("chosen") .. s1 .. " + " .. s2, {Color = #YELLOW})
	ShowBustRisk()
	ShowPrimaryButton(T("bRollAgain"))
	ShowEndTurnButton()
EndFunction

Function OnColChoice(msg)
	If aiThinking Then Return
	If choicePending = False Then Return
	Local spalte = choiceCol1
	If msg.id = choiceBtnId2 Then spalte = choiceCol2

	HideColChoice()
	choicePending = False
	AnimatedMove(spalte)
	DrawBoard()

	SetFillStyle(#FILLCOLOR)
	Box(panelX, 84, 810 - panelX, 30, #BLACK)
	SetFont(#SANS, 22)
	TextOut(panelX, 87, T("chosenCol") .. ToString(spalte), {Color = #YELLOW})
	ShowBustRisk()
	ShowPrimaryButton(T("bRollAgain"))
	ShowEndTurnButton()
EndFunction

Function StartGame()

	winner        = 0
	currentPl     = 1
	gewuerfelt    = False
	selectedIdx   = -1
	choicePending = False
	aiThinking    = False
	InitPlayers()
	phase = "spielen"

	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(0, 0, panelX - 2, 555, #BLACK)
	DrawBoard()
	ShowStatus()
EndFunction

Function OnPrimaryAction(msg)
	If aiThinking Then Return

	If phase = "bust"
		NextPlayer()
		Return
	EndIf

	If phase <> "spielen" Then Return
	If winner > 0 Then Return
	If choicePending Then Return

	If gewuerfelt = False
		DoThrowDice()
	ElseIf selectedIdx >= 0
		SaveTempMarker()
		gewuerfelt = False
		DoThrowDice()
	EndIf
EndFunction

Function OnGlobalKey(msg)
	If msg.key <> "ESC" Then Return
	If aiThinking Or asking Then Return
	If phase = "menu"
		End()
	ElseIf phase = "regeln"
		ShowMenu()
	Else
		LeaveToMenu()
	EndIf
EndFunction

Function OnEndTurn(msg)
	If aiThinking Then Return
	If phase <> "spielen" Then Return
	If choicePending Then Return
	FinishTurn()
EndFunction

Function FinishTurn()
	CommitTempMarker()

	ClearButtons()
	DrawBoard()

	If winner > 0
		PlaySample(sndWin)
		BlinkWinnerColumns()
		HideEndTurnButton()
		HidePrimaryButton()
		ClearPanel()
		SetFont(#SANS, 22)
		Local sieger$ = T("player")
		If isComputer[winner] Then sieger$ = T("computer")
		TextOut(panelX, 290, sieger$ .. ToString(winner), {Color = spielerFarben[winner]})
		TextOut(panelX, 322, T("wins"), {Color = spielerFarben[winner]})
		ShowWinButtons()
		phase = "ende"
		Return
	EndIf

	NextPlayer()
EndFunction

Function OnQuitGame(msg)
	End()
EndFunction

Function LeaveToMenu()
	ClearButtons()
	HideEndTurnButton()
	HidePrimaryButton()
	HideColChoice()
@IF #HW_AMIGA
	HideGameFullButton()
@ENDIF
	choicePending = False
	gewuerfelt    = False
	If restartActive
		DeleteButton(restartBtnId)
		restartActive = False
	EndIf
	If quitActive
		DeleteButton(quitBtnId)
		quitActive = False
	EndIf
	ShowMenu()
EndFunction

Function OnRestartGame(msg)
	LeaveToMenu()
EndFunction

Function AiColValue(col)
	If ColPlayable(col) = False Then Return(0)
	Local v = 7 - Abs(col - 7)
	If tempMarker[col] > 0 Then v = v + 4
	Return(v)
EndFunction

Function AiPickPairIdx()

	Local best = -1
	Local bestScore = -1
	For Local i = 0 To wurfAnzahl - 1
		If PairPlayable(wurf[i].sum1, wurf[i].sum2)
			Local sc = AiColValue(wurf[i].sum1) + AiColValue(wurf[i].sum2)
			If sc > bestScore
				bestScore = sc
				best = i
			EndIf
		EndIf
	Next
	Return(best)
EndFunction

Function AiPickColumn(c1, c2)
	If AiColValue(c1) >= AiColValue(c2) Then Return(c1) Else Return(c2)
EndFunction

Function AiShouldStop()

	If CountTempCols() < 3 Then Return(False)

	Local progress = 0
	For Local col = 2 To 12
		If tempMarker[col] > 0
			progress = progress + (tempMarker[col] - rowStore[RowKey(currentPl, col)])
			If tempMarker[col] >= ColHeight(col) Then Return(True)
		EndIf
	Next

	Local pct = BustPercent()
	If pct * progress >= (100 - pct) * 2 Then Return(True)
	Return(False)
EndFunction

Function DrawPairLine(pairIdx, farbe)
	Local lineY = pairListY + pairIdx * pairListStep
	SetFillStyle(#FILLCOLOR)
	SetFormStyle(#BORDER, #BLACK, 1)
	Box(panelX, lineY, 810 - panelX, pairLineH, #BLACK)
	SetFont(#SANS, 22)
	TextOut(panelX, lineY, T("pair") .. wurf[pairIdx].sum1 .. " + " .. wurf[pairIdx].sum2, {Color = farbe})
EndFunction

Function PairColor(pairIdx)
	If PairPlayable(wurf[pairIdx].sum1, wurf[pairIdx].sum2) Then Return(#WHITE)
	Return(#GRAY)
EndFunction

Function AiThinkAnimation(pidx)
	For Local runde = 1 To 2
		For Local i = 0 To wurfAnzahl - 1
			If PairPlayable(wurf[i].sum1, wurf[i].sum2)
				DrawPairLine(i, #YELLOW)
				Wait(10)
				DrawPairLine(i, PairColor(i))
			EndIf
		Next
	Next
	DrawPairLine(pidx, #YELLOW)
	Wait(20)
EndFunction

Function AiApplyPair(pidx)
	RestoreTempMarker()
	selectedIdx = pidx
	Local s1 = wurf[pidx].sum1
	Local s2 = wurf[pidx].sum2
	DrawBoard()
	If PairNeedsChoice(s1, s2)
		AnimatedMove(AiPickColumn(s1, s2))
	Else
		AnimatedApplyPair(s1, s2)
	EndIf
	DrawBoard()

	DrawPairLine(pidx, #YELLOW)
EndFunction

Function PlayComputerTurn()
	aiThinking = True
	Repeat
		Wait(25)
		DoThrowDice()
		If phase = "bust"
			Wait(60)
			aiThinking = False
			NextPlayer()
			Return
		EndIf
		Local pidx = AiPickPairIdx()
		AiThinkAnimation(pidx)
		AiApplyPair(pidx)
		Wait(45)
		If AiShouldStop()
			aiThinking = False
			FinishTurn()
			Return
		EndIf
		SaveTempMarker()
		gewuerfelt = False
	Forever
EndFunction

InitRunnerSprites()
ShowMenu()

InstallEventHandler({
	OnRightMouseUp = OnPrimaryAction,
	OnKeyDown      = OnGlobalKey
})

Repeat
	WaitEvent
Forever
