strings["en_langLabel"]   = "Language"
strings["de_langName"]    = "Deutsch"
strings["en_langName"]    = "English"
strings["de_rulesTitle"]  = "REGELN"
strings["en_rulesTitle"]  = "RULES"
strings["de_bBack"]       = "Zurück"
